# ---------------------------------------------------------------------------
# NEXUS environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe to expose to the browser: it is
# constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role / secret key. SERVER ONLY - bypasses Row Level
# Security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by migrations, the seed engine and
# server-side KPI queries.
# Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Anthropic API key, used by the AI analyst layer (added in a later milestone).
ANTHROPIC_API_KEY=
